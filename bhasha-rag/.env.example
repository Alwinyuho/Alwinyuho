# Languages to load at startup, and which model profile to use (cpu or gpu).
BHASHARAG_LANGS=hi,ta
BHASHARAG_PROFILE=cpu

# Optional LLM for generated answers. Any OpenAI-compatible endpoint works.
# Without these, the app returns an extractive answer quoting the best passage.
# Example for a local Ollama server:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:4b
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
